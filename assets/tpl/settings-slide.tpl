<!-- SETTINGS -->
<aside id="settings-slide" class="slide-left col col-sm-6 col-md-4 bg-dark transition md-z-index fx pr-0 overflow pb-4 pt-2">
    <a id="slide-link" href="#body" class="btme pulse-red tdu-none white br-50 fr cp">👆</a>
    <div class="hbnh bs">
        <span>⚙️</span>
        <span class="ml-1 i18n" data-i18n-html="settings_slide.title"></span>
    </div>
    <div class="col-12 px-0 mt-4 i18n" style="border-bottom: 1px solid #e4e4e4;" data-i18n-html="settings_slide.media_api"></div>
    <div class="row mt-2">
        <div class="col-12">
            <div id="sets-media-audio" class="row preference-switch cp">
                <div class="col-1 text-center">
                    <span class="preference-indicator">🔴</span>
                </div>
                <div class="col-10">
                    <span data-css-fs=".9" class="css i18n" data-i18n-html="settings_slide.auto_audio"></span>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div id="sets-media-video" class="row preference-switch cp">
                <div class="col-1 text-center">
                    <span class="preference-indicator">🔴</span>
                </div>
                <div class="col-10">
                    <span data-css-fs=".9" class="css i18n" data-i18n-html="settings_slide.auto_video"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 px-0 mt-4 i18n" style="border-bottom: 1px solid #e4e4e4;" data-i18n-html="settings_slide.geo_api"></div>
    <div class="row mt-2">
        <div class="col-12">
            <div id="sets-geo-stats" class="row preference-switch cp">
                <div class="col-1 text-center">
                    <span class="preference-indicator">🔴</span>
                </div>
                <div class="col-10">
                    <span data-css-fs=".9" class="css i18n" data-i18n-html="settings_slide.geo_share"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 px-0 mt-4 i18n" style="border-bottom: 1px solid #e4e4e4;" data-i18n-html="settings_slide.audio_effects"></div>
    <div class="row mt-2">
        <div class="col-12">
            <div id="sets-effect-audio" class="row preference-switch cp">
                <div class="col-1 text-center">
                    <span class="preference-indicator">🔴</span>
                </div>
                <div class="col-10">
                    <span data-css-fs=".9" class="css i18n" data-i18n-html="settings_slide.audio_effects_on"></span>
                </div>
            </div>
        </div>
        <div class="col-12">
            <div id="sets-effect-notific" class="row preference-switch cp">
                <div class="col-1 text-center">
                    <span class="preference-indicator">🔴</span>
                </div>
                <div class="col-10">
                    <span data-css-fs=".9" class="css i18n" data-i18n-html="settings_slide.audio_notify_on"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 px-0 mt-4 i18n" style="border-bottom: 1px solid #e4e4e4;" data-i18n-html="settings_slide.connection"></div>
    <div class="row mt-2">
        <div class="col-12">
            <div id="sets-conn-notific" class="row preference-switch cp">
                <div class="col-1 text-center">
                    <span class="preference-indicator">🔴</span>
                </div>
                <div class="col-10">
                    <span data-css-fs=".9" class="css i18n" data-i18n-html="settings_slide.notify_off"></span>
                </div>
            </div>
        </div>
    </div>
    <div class="col-12 px-0 mt-4 i18n" style="border-bottom: 1px solid #e4e4e4;" data-i18n-html="settings_slide.analytics"></div>
    <div class="row mt-2">
        <div class="col-12">
            <div id="sets-conn-notific2" class="row preference-switch cp">
                <div class="col-1 text-center">
                    <span class="preference-indicator">🔴</span>
                </div>
                <div class="col-10">
                    <span data-css-fs=".9" class="css i18n" data-i18n-html="settings_slide.analytics_toggle"></span>
                </div>
            </div>
        </div>
    </div>
</aside>