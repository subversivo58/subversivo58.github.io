    "pages": {
        "about": {
            "heading": "技术、趋势与网络文化",
            "item1": "✓ Web APIs、JavaScript 与 HTML5 特性。",
            "item2": "✓ 函数式编程、设计模式、框架。",
            "item3": "✓ WebCrypto、实验室与代码实验瓶。",
            "item4": "✓ 观点、生活方式、极客文化及更多。",
            "photo": "摄影：<a href=\"https://unsplash.com/@glenncarstenspeters\" target=\"_blank\" rel=\"noopener\" class=\"ext-link-icon\">Glenn Carstens-Peters</a>，发布于 <a href=\"https://unsplash.com/\" target=\"_blank\" rel=\"noopener\" class=\"ext-link-icon\">Unsplash</a>",
            "title": "关于",
            "p1": "你好，我是 Lauro Moraes，网名 <a href=\"https://www.google.com/search?q=subversivo58\" class=\"ext-link-icon\" target=\"_blank\" rel=\"noopener\">Subversivo58</a>，本网站是我的数字实验室和个人博客。",
            "p2": "在这里，我发布关于技术趋势、网络文化以及面向 Web 的编程内容，例如 PWA、单页应用以及现代 JavaScript、HTML5 和 CSS3 API 的应用。",
            "p3": "我热衷于函数式编程、模式设计以及 Web 去中心化等话题… 区块链与 Web 加密技术是这里经常讨论的主题。",
            "p4": "这里也是我发布实验成果、分享代码和小型函数式片段的地方，同时我还会分享对各种话题的看法、一些极客文化以及这种生活方式。",
            "p5": "欢迎自由浏览博客内容并加入我们的社区。"
        },
        "you_in_control": {
            "heading": "由您掌控自己的数据",
            "item1": "✓ 隐私是您的权利，而不是供人售卖的商品。",
            "item2": "✓ 加密技术是一切数字安全的基础。",
            "item3": "✓ 尊重隐私始于尊重您的选择。",
            "item4": "✓ 由您决定分享什么数据、何时分享以及与谁分享。",
            "photo": "摄影：<a href=\"https://unsplash.com/@ev\" target=\"_blank\" rel=\"noopener\" class=\"ext-link-icon\">ev</a>，发布于 <a href=\"https://unsplash.com/\" target=\"_blank\" rel=\"noopener\" class=\"ext-link-icon\">Unsplash</a>"
        },
        "donations": {
            "heading": "想做点酷事吗？",
            "photo": "摄影：<a href=\"https://unsplash.com/@clarktibbs\" target=\"_blank\" rel=\"noopener\" class=\"ext-link-icon\">Clark Tibbs</a>，发布于 <a href=\"https://unsplash.com/\" target=\"_blank\" rel=\"noopener\" class=\"ext-link-icon\">Unsplash</a>",
            "thanks_title": "致谢",
            "thanks_text": "我们非常自豪地使用 <a href=\"https://pages.github.com/\" target=\"_blank\" rel=\"nofollow noopener\" class=\"ext-link-icon\">Github Pages</a> 和 <a href=\"https://workers.cloudflare.com/\" target=\"_blank\" rel=\"nofollow noopener\" class=\"ext-link-icon\">Cloudflare Workers</a> 服务，这些平台及其工具非常出色，使我们能够构建像本博客和我们的工具这样酷的项目。",
            "platforms_title": "了解这些平台",
            "link_github": "GitHub Pages",
            "link_workers": "Cloudflare Workers",
            "donate_title": "您的捐赠至关重要",
            "content": {
                "intro1": "保持博客更新需要时间和精力。虽然我们使用的平台和工具是免费的，但它们都有一定限制。每个平台都限制了网站每月的访问量，以及访问期间可从其服务器传输的数据量。",
                "intro2": "在这个博客中，我们喜欢探索新功能、实现新特性，甚至扩大服务范围并建立一个充满活力和动态的社区。",
                "intro3": "为了实现这些想法，我们需要投入资源来购买独立域名、能够承受更大流量的 VPS 服务器、存储空间，并支持构建更广泛的应用。",
                "intro4": "我们厌恶通过广告、付费墙、付费追踪或出售数据来筹集资金… 正如我们的<a href=\"./you-in-control-of-your-data.html\" title=\"白皮书\" target=\"about:blank_\" rel=\"nofollow noopener\" class=\"ext-link-icon\">《白皮书》</a>所述，我们捍卫并<strong>相信您是自己数据的唯一所有者</strong>，因此您的一点帮助就能带来巨大改变，激励并帮助我们做得更多、更好 🚀",
                "contribution1": "您可以通过多种方式为本博客做出贡献：在您的社交网络上分享、改进代码、参与编辑协作、与我们的社区互动等等。",
                "contribution2": "也可以考虑选择下方的捐赠方式之一，给予我们“<b>额外的一份支持</b>” 🎊",
                "pix_caption": "PagBank Pix",
                "trademarks": "此处使用的徽标和商标均归其各自的权利所有者所有。在此使用它们并不代表与这些品牌有任何关联或获得其认可。"
            }
        },
        "dpo": {
            "heading": "数据保护官 (DPO)",
            "intro1": "根据《通用数据保护法》（LGPD - 第 13.709/2018 号法律），我们特此公布我们的数据保护官（Data Protection Officer）的联系方式。",
            "intro2": "DPO 是负责在网站、数据主体（您）与国家数据保护局（ANPD）之间协调沟通的负责人。",
            "contact_title": "联系信息",
            "officer": "<strong>负责人：</strong> Lauro de Moraes",
            "email": "电子邮箱：",
            "deadline": "<strong>回复期限：</strong> 根据适用于小型数据处理机构的规定，最长 30 天。",
            "send_email": "给 DPO 发送电子邮件",
            "rights_title": "如何行使您的权利",
            "rights1": "如需行使 LGPD 第 18 条规定的任何权利（如处理确认、访问、更正、匿名化、删除等），只需发送电子邮件至上述地址即可。",
            "rights2": "为加快处理速度，建议您在邮件主题或正文中包含以下信息：",
