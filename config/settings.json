            {
                "id": "WbJwKG1aG",
                "title": "O futuro da programação moderna: agentes de I.A.",
                "content": "Este doodle descreve o futuro da programação moderna. Agentes de I.A. em toda a cadeia de processos...desde a criação, depuração e análise de estatísticas tudo terá (em algum momento) um agente de I.A. operando \"por trás das cortinas\".",
                "image": "assets/footoodles/images/WbJwKG1aG.webp"
            },
            {
                "id": "2PvjPzlqW",
                "title": "Arquitetura de Software e Código Limpo",
                "content": "O doodle ilustra a arquitetura de sistemas web modernos: destacando editores de código com destaque de sintaxe, estruturação lógica de componentes e a interface de usuário final focada em UX.",
                "image": "assets/footoodles/images/2PvjPzlqW.webp"
            },
            {
                "id": "LXk5XbeoW",
                "title": "Do Código à Experiência do Usuário",
                "content": "O doodle ilustra a prática de programação moderna: focando na sintaxe JavaScript (document.getElementById, fetch), manipulação de DOM e consumo de APIs, conectando o código puro diretamente à interface e experiência final do usuário no navegador.",
                "image": "assets/footoodles/images/LXk5XbeoW.webp"
            },
            {
                "id": "aBnYBpYAv",
                "title": "A Anatomia do Desenvolvimento Web Moderno",
                "content": "O doodle ilustra a jornada do dev web: da lógica de programação e sintaxe em JavaScript (front/back-end) até a interface final e experiência do usuário em uma aplicação web moderna, estilizada e responsiva.",
                "image": "assets/footoodles/images/aBnYBpYAv.webp"
            }
        ],
